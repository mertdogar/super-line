// One Worker, one Durable Object class. The Worker serves the two pages from ./dist, answers /config.json, and
// forwards the WebSocket upgrade on /ws to the Durable Object that is the super-line node.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "super-line-peer-controller",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./dist" },
  "durable_objects": {
    "bindings": [{ "name": "NODE", "class_name": "PeerNode" }]
  },
  // SQLite-backed (the only kind on the Workers Free plan); the node keeps its connection snapshots here
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PeerNode"] }],
  "observability": { "enabled": true }
}
