# Stage 1 — build the SPA from workspace source (vite resolves @super-line/* to src).
FROM node:22-slim AS build
RUN corepack enable
WORKDIR /app
COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @super-line/example-playground build

# Stage 2 — Caddy serves the bundle and proxies /ws + /inspect. The Caddyfile is mounted at runtime.
FROM caddy:2
COPY --from=build /app/examples/playground/dist /srv
