{
  "name": "@super-line/plugin-peer",
  "version": "0.1.0",
  "type": "module",
  "description": "Direct client-to-client rooms for super-line — the server admits and signals, then WebRTC data channels carry the data. A paired plugin (contract · server · client).",
  "license": "MIT",
  "author": "Mert",
  "keywords": [
    "super-line",
    "plugin",
    "webrtc",
    "peer-to-peer",
    "data-channel",
    "rooms"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mertdogar/super-line.git",
    "directory": "packages/plugin-peer"
  },
  "homepage": "https://mertdogar.github.io/super-line/",
  "bugs": "https://github.com/mertdogar/super-line/issues",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./server": {
      "import": {
        "types": "./dist/server.d.ts",
        "default": "./dist/server.js"
      },
      "require": {
        "types": "./dist/server.d.cts",
        "default": "./dist/server.cjs"
      }
    },
    "./client": {
      "import": {
        "types": "./dist/client.d.ts",
        "default": "./dist/client.js"
      },
      "require": {
        "types": "./dist/client.d.cts",
        "default": "./dist/client.cjs"
      }
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "tsup && node ../../scripts/check-changelog.mjs && node ../../scripts/check-manifest.mjs"
  },
  "dependencies": {
    "@logtape/logtape": "^2.2.4",
    "zod": "^4.2.0"
  },
  "peerDependencies": {
    "@super-line/client": ">=0.18.2 <1.0.0",
    "@super-line/core": ">=0.24.0 <1.0.0",
    "@super-line/server": ">=0.25.0 <1.0.0"
  },
  "peerDependenciesMeta": {
    "@super-line/client": {
      "optional": true
    },
    "@super-line/server": {
      "optional": true
    }
  },
  "devDependencies": {
    "@super-line/client": "workspace:^",
    "@super-line/core": "workspace:^",
    "@super-line/server": "workspace:^",
    "@super-line/transport-loopback": "workspace:*"
  }
}
