{
  "name": "@super-line/plugin-queue",
  "version": "0.1.0",
  "type": "module",
  "description": "Durable, collection-backed queues and cluster-wide cron workers for super-line.",
  "license": "MIT",
  "author": "Mert",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    }
  },
  "files": ["dist", "README.md", "CHANGELOG.md"],
  "sideEffects": false,
  "engines": { "node": ">=18" },
  "publishConfig": { "access": "public" },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "tsup && node ../../scripts/check-changelog.mjs && node ../../scripts/check-manifest.mjs"
  },
  "dependencies": {
    "cron-parser": "^5.4.0",
    "dayjs": "^1.11.13",
    "zod": "^4.2.0"
  },
  "peerDependencies": {
    "@super-line/core": ">=0.16.0 <1.0.0",
    "@super-line/server": ">=0.15.0 <1.0.0"
  },
  "devDependencies": {
    "@super-line/client": "workspace:^",
    "@super-line/collections-memory": "workspace:*",
    "@super-line/core": "workspace:^",
    "@super-line/server": "workspace:^",
    "@super-line/transport-loopback": "workspace:*"
  }
}
