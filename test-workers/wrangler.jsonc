// The Worker the workers lane runs tests against. `main` hosts the Durable Object classes the
// lane needs; packages add their own classes here as they gain workerd tests.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "super-line-workers-lane",
  "main": "./worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      { "name": "SMOKE", "class_name": "SmokeNode" },
      { "name": "RAW", "class_name": "RawNode" },
      { "name": "APP", "class_name": "AppNode" },
      { "name": "STORE", "class_name": "StoreNode" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["SmokeNode"] },
    { "tag": "v2", "new_sqlite_classes": ["RawNode"] },
    { "tag": "v3", "new_sqlite_classes": ["AppNode"] },
    { "tag": "v4", "new_sqlite_classes": ["StoreNode"] }
  ]
}
